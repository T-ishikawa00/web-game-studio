---
import type {Locale} from '../data/games';
import site from './site.json';
import {saveCopy} from './save-copy';
import {registry} from '../data/games';
interface Props{locale:Locale;page:string}
const {locale,page}=Astro.props,t=(ja:string,en:string)=>locale==='ja'?ja:en;
const title={about:t('スタジオについて','About the studio'),terms:t('利用規約（草案）','Terms (draft)'),privacy:t('プライバシー（草案）','Privacy (draft)'),contact:t('お問い合わせ','Contact'),credits:t('クレジット・動画利用（草案）','Credits & video use (draft)')}[page];
const deliveryName=registry.find(g=>g.id==='tiny-delivery')!.title[locale];
const pending=t('未確定（公開前に決定）','Undecided (required before publication)');
const audience=t('一般向け。生年月日・年齢の入力や年齢Gateは設けず、子ども向けサービスとして積極的に訴求しません。','For a general audience. We do not request date of birth or age, use an age gate, or actively promote the service as child-directed.');
const operatorPolicy=t(`${site.creatorBrand}は個人運営の制作ブランドであり、法人名ではありません。公開する運営者の表記は最終確認中です。`,`${site.creatorBrand} is an individually operated creator brand, not a company name. The public operator identity is awaiting final confirmation.`);
const publicFacts=[
 [t('公開運営者','Public operator'),site.publicOperator],
 [t('運営者の住所等の表示方針','Operator address disclosure'),site.releaseDecisions.operatorAddressDisclosure],
 [t('公開ドメイン','Public domain'),site.domain],
 [t('対象市場','Markets'),site.markets],
 [t('対象・年齢方針','Audience and age policy'),audience],
 [t('問い合わせ先','Contact channel'),site.publicContact],
 [t('受信・返信方法','Receipt and reply process'),site.releaseDecisions.contactReceiptAndReply],
 [t('問い合わせの保持・削除','Contact retention and deletion'),site.releaseDecisions.contactRetentionAndDeletion],
 [t('配信事業者・アクセス処理の保持','Hosting provider and access-data retention'),site.releaseDecisions.hostingProcessorAndAccessRetention],
 [t('計測・同意方針','Measurement and consent policy'),site.releaseDecisions.analyticsAndConsent]
];
const rows=[
 ['wgs:save:<gameId>',t('盤面・クリア記録・動きを控える設定','Board, completions, reduced motion'),t('localStorage。進行消去またはサイトデータ削除。自動期限なし。','localStorage. Erase progress or clear site data. No automatic expiry.')],
 ['wgs:audio:<gameId>',t('作品別の消音・効果音量','Per-game mute and SFX gain'),t('localStorage。設定変更／サイトデータ削除。進行消去では残る。','localStorage. Change settings / clear site data. Progress reset retains it.')],
 ['wgs:music-pilot:tiny-delivery',t(`${deliveryName}のBGM有効・音量・採用曲`,`${deliveryName} music enabled, gain, accepted track`),t('localStorage。設定変更／サイトデータ削除。進行消去では残る。','localStorage. Change settings / clear site data. Progress reset retains it.')],
 ['wgs:guide:<gameId>',t('閉じた案内の面ID','Dismissed guide level IDs'),t('localStorage。サイトデータ削除。進行消去では残る。','localStorage. Clear site data. Progress reset retains it.')],
 ['wgs:capture-layout / wgs:input:two-ways-home',t('表示切替・方向ボタン','Display layout and direction buttons'),t('sessionStorage。設定変更／タブsession終了。ブラウザ復元動作に依存。','sessionStorage. Change settings / end tab session; browser restoration may retain it.')],
 ['wgs:session:v1',t('開始イベントの重複抑制。値は固定のstartedで個人識別子ではない','Session-start deduplication. Fixed value started; not a personal identifier'),t('sessionStorage。タブsession終了。','sessionStorage. Ends with the tab session.')],
 [t('操作イベント','Interaction events'),t('開始・読込・入力・クリア・保存結果・回遊','Start, load, input, completion, save result, navigation'),t('メモリ内のログ1つにつき最大50件。PlayページにはPortal用とゲーム接続用の2つがあり、合計最大100件。ページ破棄で消え、保存・外部送信しません。','At most 50 events per in-memory log. Play pages have separate portal and game-shell logs, up to 100 in total. Discarded with the page; never persisted or transmitted externally.')],
 ];
---
<article class="prose-page"><span class="badge draft">{t('ローカル草案 · 公開前の最終確認待ち','Local draft · Final review before publication')}</span><h1>{title}</h1><p>{site.officialSiteName}{locale==='ja' ? `（${site.pronunciation.ja}）` : ''}</p>
 {page==='about'&&<><p>{saveCopy[locale].short} {t('Cloud Saveはありません。','There is no Cloud Save.')}</p><p class="lead">{t('光をつなぐ。歩幅をそろえる。道をゆずる。3つの自作パズルを、日本語と英語で。','Bend the light. Find your step. Make a little room. Three original puzzles in Japanese and English.')}</p><p>{t('無料・ゲーム内購入なし。この候補版に広告はありません。AI支援によるコード・Art制作とローカルの音合成を用いています。','Free to play, with no in-game purchases or ads in this candidate. Development uses AI-assisted code and art, and locally synthesized sound.')}</p><p>{operatorPolicy}</p><p>{audience}</p></>}
 {page==='terms'&&<><p class="draft-note">{t('この文面は法務最終確認前の草案です。未確定事項を解消し、公開許可を得るまで一般公開しません。','This draft awaits final legal review. Unresolved conditions and publication approval must be addressed before a public launch.')}</p><h2>{t('利用と保存','Play and saves')}</h2><p>{t('初回Soft Launchは無料3作品・日本語/英語で、課金・実広告・アカウント・必須ログインはありません。','The initial Soft Launch offers three free games in Japanese and English, with no purchases, real ads, accounts or required login.')}</p><p>{saveCopy[locale].detail}</p><p>{saveCopy[locale].limits}</p><p>{t('進行消去はこの作品の盤面・クリア記録・動きを控える設定を削除し、音・ガイド・表示設定は残します。ブラウザのサイトデータ削除では、サイトの全作品の保存・設定を削除できます。復元は保証しません。','Erase progress removes this game’s board, completions and reduced-motion setting, retaining sound, guide and display preferences. Clearing browser site data can remove saves and settings for all games on the site. Recovery is not guaranteed.')}</p><h2>{t('作品と他者の権利','Rights and acceptable use')}</h2><p>{t('他者の権利を侵害する再配布、なりすまし、サービスを妨害する利用は認めません。利用者に適用される強行法規上の権利を制限するものではありません。責任範囲、準拠法、紛争対応は対象市場の決定後に確認します。','Do not redistribute in violation of others’ rights, impersonate the operator, or disrupt the service. Mandatory rights under applicable law are not waived. Liability, governing law and dispute handling await review for the selected markets.')}</p><h2>{t('対象・運営情報','Audience and operator')}</h2><p>{operatorPolicy}</p><p>{audience}</p><p>{t('対象年齢・対象市場・公開運営者・連絡先は下記の運営情報に示します。年齢の記載だけで子どもに関する法令への対応が完了するとは扱いません。','Target age, markets, public operator and contact details are listed below. An age statement alone does not resolve obligations concerning children.')}</p><a class="text-link" href={`/${locale}/credits/`}>{t('実況・動画利用の草案','Draft video and streaming policy')} →</a></>}
 {page==='privacy'&&<><p>{t('初回Soft Launchにはアカウント・必須ログイン・Cloud Saveがなく、外部Analytics・実広告は現時点で未接続です。進行の継続と設定保持のため、ゲームごとにlocalStorageを使用します。不要な個人情報を収集しません。個人識別子やfingerprintを作成せず、操作イベントを外部へ送信しません。','The initial Soft Launch has no accounts, required login or Cloud Save. External analytics and real ads are not connected. Each game uses localStorage to retain progress and preferences. We do not collect unnecessary personal information, create personal identifiers or fingerprints, or transmit interaction events externally.')}</p><p>{saveCopy[locale].detail}</p><p>{saveCopy[locale].limits}</p><div class="table-scroll"><table><thead><tr><th>{t('データ','Data')}</th><th>{t('目的','Purpose')}</th><th>{t('保存先・削除','Storage and deletion')}</th></tr></thead><tbody>{rows.map(r=><tr>{r.map(c=><td>{c}</td>)}</tr>)}</tbody></table></div><p>{t('進行消去は当該作品の進行だけを消し、音やガイド・表示設定は残します。全情報を消す場合はブラウザのサイトデータ削除を使います。別ポート・別ドメインの保存は別管理です。保存拒否・破損時は一時モードとし、認識できない原データを自動上書きしません。','Progress reset only removes that game’s progress, retaining sound, guide and display preferences. Clear browser site data to remove all data. Other ports and domains have separate storage. Unavailable or unrecognized saves use temporary mode without automatically overwriting the original.')}</p><h2>{t('計測方針','Measurement policy')}</h2><p>{t('初回公開ではCloudflare Web Analyticsによるページ・性能計測だけを予定しています。現在は無効です。ゲーム起動・入力・進行などの独自イベントは初回公開の対象外です。永続ユーザーIDやfingerprintは追加しません。保持・アクセス処理・同意の扱いは公開前に確定します。','The initial release is planned to use only Cloudflare Web Analytics for page and performance measurement. It is currently disabled. Custom game-start, input and progress events are excluded from the initial release. We will not add persistent user IDs or fingerprints. Retention, access processing and consent handling must be finalized before publication.')}</p><p>{audience}</p><h2>{t('通信と公開前の未確定事項','Requests and production decisions')}</h2><p>{t('HTML・画像・ゲーム・音楽は同じローカルサーバーから取得します。本番配信の第一候補はCloudflare Workers Static Assetsです。アクセス処理・問い合わせ処理・保持期間・公開時のデータ方針の最終確認・適用法域と保存への同意要否は未確定です。「個人情報を一切扱わない」または法令完全準拠の保証ではありません。','HTML, images, games and music are requested from the same local server. Cloudflare Workers Static Assets is the preferred production host. Access processing, contact processing, retention, final public data policy, jurisdictions and storage consent requirements remain undecided. This is not a promise of no personal-data processing or complete legal compliance.')}</p></>}
 {page==='contact'&&<><p class="lead">{site.publicContact ?? t('公開のお問い合わせ先は、まだ設定されていません。','A public contact channel has not been set up yet.')}</p><p>{t('公開運営者表記・窓口・対応方法・問い合わせ情報の保持期間を決定してから、このページへ反映します。現在、問い合わせを送信するフォームはありません。','The operator, contact channel, handling process and retention period must be decided before this page is finalized. There is currently no submission form.')}</p>{site.publicContact&&<a href={`mailto:${site.publicContact}`}>{site.publicContact}</a>}</>}
 {page==='credits'&&<><h2>{t('制作と素材','Production and assets')}</h2><p>{site.creatorBrand}</p><p>{t(`ゲームのコード・SVG/CSS Art・盤面はAI支援を用いた自作です。LightworkとTwo Waysの効果音は作品専用のローカル合成、${deliveryName}は採用Motion/SFXとBGM B（D1 Rhythm Refine・80 BPM）です。LightworkとTwo WaysにBGMはありません。カバーは採用版の実画面から作成しています。`,`Game code, SVG/CSS art and puzzles are made with AI assistance. Lightwork and Two Ways use their own locally synthesized effects. ${deliveryName} uses accepted motion/SFX and music B (D1 Rhythm Refine, 80 BPM). Lightwork and Two Ways have no music. Covers come from the actual accepted game screens.`)}</p><p>{t('外部fontファイルは配布せず、端末のシステムfontを使用します。サイト生成にはAstroを使用しています。','No font files are distributed; the site uses system fonts. The site is generated with Astro.')}</p><a href="/licenses/astro.txt">Astro / MIT notices</a><h2>{t('実況・動画利用（未承認草案）','Streaming and video use (unapproved draft)')}</h2><p>{t('権利確認と最終承認後に、対象素材・収益化・切り抜き等の許可範囲を案内する予定です。この草案は包括的な配信・再配布許可ではありません。第三者の権利を自動許諾せず、Content ID等による申し立てが起きないことも保証しません。音楽は設定で無効にできます。','After rights review and final approval, the policy will specify covered assets, monetization and clips. This draft grants no blanket streaming or redistribution permission, cannot license third-party rights, and does not guarantee freedom from Content ID claims. Music can be disabled in settings.')}</p><p>{t('AI支援・ローカル合成は独占的著作権や非侵害を保証しません。名称はSoft Launch用に固定済みです。素材・実況範囲の権利確認は公開前の課題です。','AI assistance and local synthesis do not guarantee exclusive copyright or non-infringement. Names are frozen for the Soft Launch. Asset rights and video permissions await final review before publication.')}</p></>}
 {['about','contact','privacy','terms'].includes(page)&&<><h2>{t('公開前に確定する運営情報','Operating information to finalize before publication')}</h2><dl>{publicFacts.map(([label,value])=><><dt><strong>{label}</strong></dt><dd>{value??pending}</dd></>)}</dl></>}
 {page==='contact'&&<p>{t('問い合わせを開始すると、メールアドレス・本文・返信履歴等を窓口のサービスが扱います。ゲームの保存とは別の処理です。窓口の決定時に受信確認、返信担当、保持期間、削除依頼の方法を表示します。秘密情報やゲームの全保存データを送る必要はありません。','A contact service will process the sender’s email address, message and replies. This is separate from game saves. Receipt confirmation, reply ownership, retention and deletion requests will be explained when the channel is selected. Do not send secrets or complete game saves.')}</p>}
 {page==='privacy'&&<p>{t('公開時には配信事業者がHTTP要求のIPアドレスや通信情報を処理し得ます。永続ユーザーIDを作らないことだけで、個人データ処理や同意の検討が不要になるわけではありません。配信、問い合わせ、任意の計測、端末内保存を分けて確認します。現在このローカル候補版に外部計測を追加していません。','On publication, the hosting provider may process IP addresses and HTTP request information. Avoiding persistent user IDs does not remove the need to assess personal-data processing or consent. Hosting, contact handling, optional measurement and device-local saves are reviewed separately. No external measurement has been added to this local candidate.')}</p>}
</article>
