---
import type {Game,Locale} from '../data/games';
import assets from './island-assets.json';
const {game,locale}=Astro.props as {game:Game;locale:Locale};
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="color-scheme" content="light"><meta name="robots" content="noindex,nofollow"><meta name="description" content={game.description[locale]}><title>{game.title[locale]} | Tinlumo</title><link rel="stylesheet" href={assets.css}/><style is:inline>.portal-return{color:inherit;text-decoration:none;display:block;min-height:44px;align-content:center}.portal-return:focus-visible{outline:2px solid currentColor;outline-offset:4px}</style></head><body><main id="app"><div id="loading">{locale==='ja'?'島を準備しています…':'Preparing your island…'} <a href="./">{locale==='ja'?'再試行':'Retry'}</a></div></main><script is:inline type="module" src={assets.js}></script><noscript>{locale==='ja'?'遊ぶにはJavaScriptを有効にしてください。':'Enable JavaScript to play.'}<a href={`/${locale}/games/`}>Tinlumo</a></noscript></body></html>