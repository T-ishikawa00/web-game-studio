---
import Layout from '../../Layout.astro';
import {saveCopy} from '../../save-copy';
import Play from '../../Play.astro';
import Operations from '../../Operations.astro';
import PublicOperations from '../../PublicOperations.astro';
import Hero from '../../../components/Hero.astro';
import {candidateGames,instructions,candidateIds} from '../../profile';
import {locales,type Locale,type Game} from '../../../data/games';
import {levelsByGame,type GameId} from '../../../prototypes/levels';
export function getStaticPaths(){return locales.flatMap(locale=>[
 ...['','games','about','privacy','terms','contact','credits'].map(path=>({params:{locale,path:path||undefined},props:{locale,path}})),
 ...candidateGames.flatMap(game=>['games','play'].map(prefix=>({params:{locale,path:`${prefix}/${game.slug}`},props:{locale,path:`${prefix}/${game.slug}`,game}})))
]);}
interface Props{locale:Locale;path:string;game?:Game}
const {locale,path,game}=Astro.props as Props,t=(ja:string,en:string)=>locale==='ja'?ja:en;
const catalog=path===''||path==='games',play=path.startsWith('play/');
const labels={about:t('スタジオについて','About'),privacy:t('プライバシー','Privacy'),terms:t('利用規約','Terms'),contact:t('お問い合わせ','Contact'),credits:t('クレジット','Credits')};
const title=game?.title[locale]??labels[path as keyof typeof labels]??t('小さなゲーム。大きなワクワク。','Small Games. Big Play.');
const selected=game?candidateGames.filter(g=>g.id!==game.id):candidateGames;
const publicCandidate = import.meta.env.TINLUMO_PUBLIC_CANDIDATE === '1';
---
<Layout locale={locale} path={path} title={title} description={game ? `${game.title[locale]} — ${game.description[locale]}` : undefined} image={game?.cover}>
 {catalog && <><Hero locale={locale}/><section class="section"><div class="section-heading"><h2>{t('3つの、小さな冒険。','Three little adventures.')}</h2><span>{t('全57問 · 日本語 / English','57 puzzles · Japanese / English')}</span></div></section></>}
 {game&&!play&&<><div class="breadcrumb"><a href={`/${locale}/games/`}>← {t('ゲーム一覧','All games')}</a></div><section class="detail-hero"><img class="detail-cover" src={game.cover} width="960" height="600" alt=""/><div class="detail-copy"><span class="badge">{levelsByGame[game.id as GameId].length} {t('問','puzzles')}</span><h1>{game.title[locale]}</h1>{game.pronunciation && locale==='ja' && <p>{game.pronunciation.ja}</p>}<p>{game.description[locale]}</p><a class="button primary" href={`/${locale}/play/${game.slug}/`}>{t('遊ぶ','Play')} →</a><dl class="game-facts"><div><dt>{t('操作','Controls')}</dt><dd>{t('タッチ・マウス・キーボード','Touch · Mouse · Keyboard')}</dd></div><div><dt>{t('端末','Devices')}</dt><dd>{publicCandidate?t('PC・モバイルブラウザ向け。','Designed for desktop and mobile browsers.'):t('PC・モバイルブラウザ向け。実機互換性は確認中。','Designed for desktop and mobile browsers. Physical-device compatibility under review.')}</dd></div></dl></div></section><section class="how-to"><p>{saveCopy[locale].detail}</p><p>{saveCopy[locale].limits}</p><h2>{t('遊び方','How to play')}</h2><p>{instructions[game.id as typeof candidateIds[number]][locale]}</p><p>{t('日本語と英語で保存を共有します。設定・ヒント・表示切替はゲーム内メニューから。','Saves are shared across Japanese and English. Open the game menu for settings, hints and display layouts.')}</p></section></>}
 {game&&play&&<Play game={game} locale={locale}/>}
 {(catalog||game)&&<section class="section"><div class="section-heading">{game&&<h2>{t('ほかの作品で遊ぶ','Try another game')}</h2>}</div><div class="card-grid rc-cards">{selected.map(g=><article class="game-card"><a href={`/${locale}/play/${g.slug}/`} data-event={game?'related_game_open':'game_card_open'} data-game={g.id} aria-label={`${g.title[locale]} — ${t('遊ぶ','Play')}`}><div class="game-cover"><img src={g.cover} width="960" height="600" alt="" loading="eager"/></div></a><div class="card-body"><h3><a href={`/${locale}/games/${g.slug}/`}>{g.title[locale]}</a></h3><p>{g.description[locale]}</p><div class="card-bottom"><a class="text-link" href={`/${locale}/games/${g.slug}/`} aria-label={`${g.title[locale]} — ${t('遊び方','Details')}`}>{t('遊び方','Details')}</a><a class="button primary" href={`/${locale}/play/${g.slug}/`} data-event={game?'related_game_open':'game_card_open'} data-game={g.id} aria-label={`${g.title[locale]} — ${t('遊ぶ','Play')}`}>{t('遊ぶ','Play')} →</a></div></div></article>)}</div></section>}
 {Object.hasOwn(labels,path)&&(publicCandidate ? <PublicOperations locale={locale} page={path}/> : <Operations locale={locale} page={path}/>)}
</Layout>
