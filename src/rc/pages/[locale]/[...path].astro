---
import Layout from '../../Layout.astro';
import {saveCopy} from '../../save-copy';
import Play from '../../Play.astro';
import Operations from '../../Operations.astro';
import PublicOperations from '../../PublicOperations.astro';
import Hero from '../../../components/Hero.astro';
import {candidateGames} from '../../profile';
import {locales,type Locale,type Game} from '../../../data/games';
import {publicGames,publicCopy,gameFacts,fullscreenGame,magnetSave} from '../../public-catalog';
import GameCards from '../../GameCards.astro';
import MagnetPlay from '../../MagnetPlay.astro';
export function getStaticPaths(){return locales.flatMap(locale=>[
 ...['','games','about','privacy','terms','contact','credits',...(import.meta.env.TINLUMO_TRUST_UX_R2==='1'?['video-policy']:[])].map(path=>({params:{locale,path:path||undefined},props:{locale,path}})),
 ...(import.meta.env.TINLUMO_TRUST_UX_R2==='1'?publicGames:candidateGames).flatMap(game=>['games','play'].map(prefix=>({params:{locale,path:`${prefix}/${game.slug}`},props:{locale,path:`${prefix}/${game.slug}`,game}})))
]);}
interface Props{locale:Locale;path:string;game?:Game}
const {locale,path,game}=Astro.props as Props,t=(ja:string,en:string)=>locale==='ja'?ja:en;
const catalog=path===''||path==='games',play=path.startsWith('play/');
const labels={about:t('スタジオについて','About'),privacy:t('プライバシー','Privacy'),terms:t('利用規約','Terms'),contact:t('お問い合わせ','Contact'),credits:t('クレジット','Credits'),'video-policy':t('実況・動画利用方針','Gameplay & video policy')};
const title=game?.title[locale]??labels[path as keyof typeof labels]??t('小さなゲーム。大きなワクワク。','Small Games. Big Play.');
const trustR2=import.meta.env.TINLUMO_TRUST_UX_R2==='1';
const lineup=trustR2?publicGames:candidateGames;
const selected=game?lineup.filter(g=>g.id!==game.id):lineup;
const full=trustR2&&game&&fullscreenGame(game.id);
const facts=game?gameFacts(game):undefined;
const publicCandidate = import.meta.env.TINLUMO_PUBLIC_CANDIDATE === '1';
---
{full&&play ? <MagnetPlay game={game!} locale={locale}/> : <Layout locale={locale} path={path} title={title} description={game ? `${game.title[locale]} — ${game.description[locale]}` : trustR2?publicCopy.description[locale]:undefined} image={game?.cover}>
 {catalog && <><Hero locale={locale}/><section class="section"><div class="section-heading"><h2>{trustR2?publicCopy.heading[locale]:t('3つの、小さな冒険。','Three little adventures.')}</h2><span>{trustR2?t('日本語 / English','Japanese / English'):t('全57問 · 日本語 / English','57 puzzles · Japanese / English')}</span></div></section></>}
 {game&&!play&&<><div class="breadcrumb"><a href={`/${locale}/games/`}>← {t('ゲーム一覧','All games')}</a></div><section class="detail-hero"><img class="detail-cover" src={game.cover} width="960" height="600" alt=""/><div class="detail-copy"><span class="badge">{facts!.count[locale]}</span><h1>{game.title[locale]}</h1>{game.pronunciation && locale==='ja' && <p>{game.pronunciation.ja}</p>}<p>{game.description[locale]}</p><a class="button primary" href={`/${locale}/play/${game.slug}/`}>{t('遊ぶ','Play')} →</a><dl class="game-facts"><div><dt>{t('操作','Controls')}</dt><dd>{facts!.controls[locale]}</dd></div><div><dt>{t('端末','Devices')}</dt><dd>{publicCandidate?t('PC・モバイルブラウザ向け。','Designed for desktop and mobile browsers.'):t('PC・モバイルブラウザ向け。実機互換性は確認中。','Designed for desktop and mobile browsers. Physical-device compatibility under review.')}</dd></div></dl></div></section><section class="how-to"><p>{full?magnetSave[locale]:saveCopy[locale].detail}</p><p>{saveCopy[locale].limits}</p><h2>{t('遊び方','How to play')}</h2><p>{facts!.instructions[locale]}</p><p>{full?t('Ⅱで一時停止。音と動きの量は上部で切り替えられます。作戦画面から保存された区画のはじめへ戻って再開できます。','Use Ⅱ to pause and the sound and motion buttons to adjust playback. Resume from the start of your saved sector on the mission screen.'):t('日本語と英語で保存を共有します。設定・ヒント・表示切替はゲーム内メニューから。','Saves are shared across Japanese and English. Open the game menu for settings, hints and display layouts.')}</p></section></>}
 {game&&play&&<Play game={game} locale={locale}/>}
 {(catalog||game)&&(trustR2?<GameCards games={selected} locale={locale} related={!!game}/>:<section class="section"><div class="section-heading">{game&&<h2>{t('ほかの作品で遊ぶ','Try another game')}</h2>}</div><div class="card-grid rc-cards">{selected.map(g=><article class="game-card"><a href={`/${locale}/play/${g.slug}/`} data-event={game?'related_game_open':'game_card_open'} data-game={g.id} aria-label={`${g.title[locale]} — ${t('遊ぶ','Play')}`}><div class="game-cover"><img src={g.cover} width="960" height="600" alt="" loading="eager"/></div></a><div class="card-body"><h3><a href={`/${locale}/games/${g.slug}/`}>{g.title[locale]}</a></h3><p>{g.description[locale]}</p><div class="card-bottom"><a class="text-link" href={`/${locale}/games/${g.slug}/`} aria-label={`${g.title[locale]} — ${t('遊び方','Details')}`}>{t('遊び方','Details')}</a><a class="button primary" href={`/${locale}/play/${g.slug}/`} data-event={game?'related_game_open':'game_card_open'} data-game={g.id} aria-label={`${g.title[locale]} — ${t('遊ぶ','Play')}`}>{t('遊ぶ','Play')} →</a></div></div></article>)}</div></section>)}
 {Object.hasOwn(labels,path)&&(publicCandidate ? <PublicOperations locale={locale} page={path}/> : <Operations locale={locale} page={path}/>)}
</Layout>}
