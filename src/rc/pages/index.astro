---
import site from '../site.json';
import '../rc.css';
import {publicCopy} from '../public-catalog';
const trustR2=import.meta.env.TINLUMO_TRUST_UX_R2==='1';
const publicCandidate = import.meta.env.TINLUMO_PUBLIC_CANDIDATE === '1';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="description" content={`${site.officialSiteName} — ${trustR2 ? publicCopy.description.en+" "+publicCopy.description.ja : "Three original browser puzzles. 日本語と英語で遊ぶ3つのパズル。"}`}/><title>{site.officialSiteName}</title></head><body><main class="language-entry"><h1>{site.officialSiteName}</h1><p lang="ja">{site.pronunciation.ja}</p><p>{trustR2 ? `${publicCopy.heading.en} / ${publicCopy.heading.ja}` : "Three little adventures. / 3つの、小さな冒険。"}</p><nav><a href="/ja/" lang="ja" data-locale-link>日本語で遊ぶ →</a><a href="/en/" lang="en" data-locale-link>Play in English →</a></nav>{!publicCandidate && <p>Local release candidate · 未公開</p>}</main>{publicCandidate && <script is:inline type="module" src="/assets/public-language.js"></script>}</body></html>
