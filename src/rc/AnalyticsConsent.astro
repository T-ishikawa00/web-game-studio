---
import type {Locale} from '../data/games';
interface Props {locale:Locale}
const {locale}=Astro.props;
const t=(ja:string,en:string)=>locale==='ja'?ja:en;
---
<section class="analytics-consent" data-analytics-consent data-enabled="false" data-beacon-id="" hidden
 data-initial-text={t('Tinlumoの改善のため、アクセス計測を許可しますか？','Allow analytics to help improve Tinlumo?')}
 data-allowed-text={t('このブラウザで計測を許可しました。いつでも選択を変更できます。','Analytics is allowed in this browser. You can change your choice at any time.')}
 data-denied-text={t('計測せずに続けます。すべてのゲーム機能を利用できます。','Continuing without analytics. All game features remain available.')}>
 <h2 class="sr-only">{t('任意のアクセス計測','Optional analytics')}</h2>
 <p data-analytics-status aria-live="polite"></p>
 <p class="analytics-detail">{t('Cloudflare Web Analyticsを使用します。選択なしでも遊べます。','Uses Cloudflare Web Analytics. You can play without choosing.')} <a href={`/${locale}/privacy/#analytics`}>{t('データの取扱い','Privacy details')}</a></p>
 <div class="analytics-actions" data-analytics-choices>
  <button type="button" data-analytics-choice="allow">{t('計測を許可する','Allow analytics')}</button>
  <button type="button" data-analytics-choice="deny">{t('計測せずに続ける','Continue without analytics')}</button>
 </div>
 <button type="button" data-close-analytics>{t('選択せずに閉じる','Close without changing')}</button>
</section>
<script is:inline type="module" src="/assets/analytics-consent.js"></script>
<style>
.analytics-consent{position:fixed;z-index:20;inset:auto 16px max(16px,env(safe-area-inset-bottom));margin:0 auto;padding:18px 20px;border:1px solid #c1cdad;border-radius:18px;max-width:680px;background:#fffef7;color:#17251e;box-shadow:0 8px 32px #20351c1c;max-height:min(60svh,280px);overflow:auto}
:global(body:has([data-analytics-consent]:not([hidden]) [data-analytics-choices]:not([hidden]))){padding-bottom:calc(min(60svh,280px) + 24px)}
/* Settings open only after an explicit user action. */
.analytics-consent[hidden],.analytics-actions[hidden],.analytics-consent:has([data-analytics-choices][hidden]){display:none}
.analytics-consent p{margin:0;color:#17251e}.analytics-consent [data-analytics-status]{font-size:1rem;font-weight:650;line-height:1.5}
.analytics-consent .analytics-detail{font-size:.8rem;line-height:1.6;color:#526147;margin:6px 0 12px}.analytics-detail a{text-decoration:underline;text-underline-offset:3px}
.analytics-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.analytics-actions button{font:inherit;font-size:.9rem;font-weight:600;background:#f4f8e9;color:#17251e;border:1px solid #687b5e;border-radius:999px;padding:10px 12px;cursor:pointer;min-height:44px;line-height:1.4}
.analytics-actions button:hover{background:#eaf2d9}.analytics-actions button:focus-visible{outline:3px solid #315bc6;outline-offset:3px}
[data-close-analytics]{font:inherit;min-height:44px;margin-top:10px;padding:8px 12px;background:transparent;border:1px solid #687b5e;border-radius:999px;cursor:pointer}[data-close-analytics]:focus-visible{outline:3px solid #315bc6;outline-offset:3px}
@media(max-width:700px){.analytics-consent{inset-inline:10px;bottom:max(10px,env(safe-area-inset-bottom));padding:16px;border-radius:16px}.analytics-actions{gap:8px}.analytics-actions button{font-size:.83rem;padding:10px 8px}.analytics-consent [data-analytics-status]{font-size:.94rem}}
</style>
