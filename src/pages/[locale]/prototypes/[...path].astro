---
import Layout from '../../../layouts/Layout.astro';
import {levelsByGame} from '../../../prototypes/levels';
const count=(id:string)=>levelsByGame[id as keyof typeof levelsByGame].length;
import { prototypes } from '../../../prototypes/catalog';
import type { Game, Locale } from '../../../data/games';
export function getStaticPaths(){return process.env.WGS_PROTOTYPE_PREVIEW==='1'?(['ja','en'] as const).flatMap(locale=>[{params:{locale,path:undefined},props:{locale}},...prototypes.map(game=>({params:{locale,path:`play/${game.slug}`},props:{locale,game}}))]):[];}
interface Props {locale:Locale;game?:Game}
const {locale,game}=Astro.props;const en=locale==='en';const t=(ja:string,eng:string)=>en?eng:ja;
const path=game?`prototypes/play/${game.slug}`:'prototypes';
---
<Layout locale={locale} title={game?.title[locale]??t('3つの、小さなはじまり。','Three little beginnings.')} path={path}>
  {game ? <>
    <div class="player-toolbar"><a class="text-link" href={`/${locale}/prototypes/`}>← {t('3作品の試遊一覧','Prototype collection')}</a><div class="player-title"><h1>{game.title[locale]}</h1><span class="badge">PROTOTYPE · {t('全'+count(game.id)+'問・Alpha',count(game.id)+' puzzles · Alpha')}</span></div></div>
    <section id="prototype-shell" data-game={game.id} data-locale={locale} data-title={game.title[locale]} data-build={game.buildPath}>
      <div id="prototype-stage"><p id="prototype-loading" role="status">{t('小さな世界を準備中…','Preparing a little world…')}</p><div id="prototype-error" role="alert" hidden><p>{t('ゲームを読み込めませんでした。','The game could not load.')}</p><button class="button secondary" id="prototype-reload">{t('再読み込み','Reload')}</button></div></div>
      <noscript>{t('遊ぶにはJavaScriptを有効にしてください。','Enable JavaScript to play.')}<style>#prototype-loading{display:none}
</style></noscript>
      <div class="save-bar"><span id="prototype-save-status" role="status"></span></div>
      <p class="prototype-note">{t('面一覧から導入も終盤も試せます。R5のVisualは採用済み。導入の分かりやすさ・全編の受入は再試遊待ちです。','Choose opening or later puzzles in Levels. R5 visuals are accepted; onboarding and full-run acceptance await another play review.')}</p>
      <details class="internal-qa"><summary>{t('内部QA・モック停止と読込エラー','Internal QA · mock pause & loading failure')}</summary><div class="qa-actions"><button class="text-button" id="prototype-reset-save">{t('この作品の進行を全消去','Erase all progress for this game')}</button><button class="button secondary" id="prototype-mock">{t('モック広告で停止','Pause for mock ad')}</button><button class="button secondary" id="prototype-fail">{t('読込失敗を再現','Simulate load failure')}</button><p id="prototype-ad-status" role="status"></p></div></details>
      <dialog id="prototype-reset-dialog"><h2>{t('この作品の保存を消去しますか？','Erase this game’s saved progress?')}</h2><p>{t('クリア記録と配置を消去します。今の面だけの再挑戦は、ゲーム内のボタンを使ってください。','This removes completion records and the saved board. To retry only this stage, use the in-game controls.')}</p><div class="dialog-actions"><button class="button secondary" id="prototype-cancel-reset">{t('キャンセル','Cancel')}</button><button class="button primary" id="prototype-confirm-reset">{t('保存を消去','Erase save')}</button></div></dialog>
      <dialog id="prototype-ad-dialog"><span class="badge">MOCK ONLY</span><h2>{t('ゲームを一時停止しています','The game is paused')}</h2><p>{t('内部QA専用です。実広告・報酬・外部通信はありません。','Internal QA only. No real ad, reward, or external connection.')}</p><button class="button primary" id="prototype-finish-ad">{t('閉じて再開','Close and resume')}</button></dialog>
    </section><script is:inline type="module" src="/prototype-assets/shell.js"></script>
  </> : <section class="prototype-hub"><span class="eyebrow accent">PROTOTYPE BATCH 01</span><h1>{t('3つの、小さなはじまり。','Three little beginnings.')}</h1><p class="lead">{t('光をつなぐ。歩幅をそろえる。道をゆずる。','Bend the light. Find your step. Make a little room.')}<br />{t('ふたりは短い導入から。保存がある場合は続きから再開します。','Two Ways Home starts with a short introduction. Existing saves resume where you left off.')}</p><div class="prototype-cards">{prototypes.map(g=><a href={`/${locale}/prototypes/play/${g.slug}/`} class="prototype-card"><img src={g.cover} alt="" width="400" height="230"/><div><span class="badge">FULL-RUN ALPHA · {count(g.id)} PUZZLES</span><h2>{g.title[locale]}</h2><p>{g.description[locale]}</p><span class="text-link">{t('遊んでみる','Try it')} →</span></div></a>)}</div><p class="prototype-note">{t('公開ゲーム0本。試作品3本。既存の10点のDesign Preview見本とは別です。広告なし・購入なし。','0 released games. 3 playable prototypes, separate from the 10 Design Preview samples. No ads or purchases.')}</p><p class="prototype-note">{t('日英は同じ進行を使います。保存はこのブラウザ・このポート内のみ。4322 / 4323 / 4324は別の保存です。','Japanese and English share progress on this origin. Saves belong to this browser and port. Ports 4322, 4323 and 4324 have separate saves.')}</p><p class="prototype-note">{t('遊んだ後に：操作とルールは自然だった？ 解けて気持ちよかった？ もっと難しい問題も遊びたい？','After playing: Were the rules and controls clear? Was solving satisfying? Would you like harder puzzles?')}</p></section>}
</Layout>
<style>
  #prototype-stage{position:relative;border:1px solid #d5ded3;border-radius:20px;overflow:hidden;background:#f0f5e9;min-height:400px}#prototype-stage :global(iframe){display:block;width:100%;height:790px;border:0}#prototype-shell[data-game=two-ways-home] #prototype-stage :global(iframe){height:920px}#prototype-loading,#prototype-error{position:absolute;inset:0;display:grid;align-content:center;justify-content:center;background:#f0f5e9;z-index:2;padding:25px}#prototype-loading[hidden],#prototype-error[hidden]{display:none}.prototype-note{font-size:.875rem;line-height:1.85;color:var(--muted);margin:16px 0}.save-bar [data-state=error]{color:#944c29}.qa-actions{display:flex;flex-wrap:wrap;gap:15px;padding:20px}.prototype-hub{padding:50px 0}.prototype-hub h1{font-size:clamp(2rem,4vw,3rem);margin:15px 0}.lead{font-size:1rem;line-height:1.9;margin-bottom:30px}.prototype-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.prototype-card{background:white;border:1px solid var(--line);border-radius:22px;overflow:hidden;text-decoration:none;color:inherit;display:block}.prototype-card img{width:100%;height:auto;display:block}.prototype-card>div{padding:22px}.prototype-card h2{font-size:1.15rem;margin:15px 0 10px}.prototype-card p{font-size:.875rem;line-height:1.8;min-height:76px}.prototype-card .text-link{display:inline-block;margin-top:20px}.prototype-card:hover{border-color:#98ad84}.player-toolbar{display:flex;align-items:center;gap:30px;padding:25px 0}.player-title h1{font-size:1.6rem}.player-title .badge{margin-top:8px}@media(max-width:700px){.prototype-cards{grid-template-columns:1fr}.prototype-card{max-width:480px}.prototype-hub{padding:30px 0}.player-toolbar{display:block;padding:18px 0}.player-title{margin-top:12px}.player-title h1{font-size:1.3rem}#prototype-stage :global(iframe){height:880px}#prototype-shell[data-game=two-ways-home] #prototype-stage :global(iframe){height:1020px}.prototype-card p{min-height:0}}
@media(max-width:350px){#prototype-shell{width:100vw;max-width:none;margin-left:calc((100% - 100vw)/2);margin-right:calc((100% - 100vw)/2)}#prototype-stage{border:0;border-radius:0}.save-bar,.prototype-note,.internal-qa{margin-left:12px;margin-right:12px}}
</style>
