---
import Layout from '../../layouts/Layout.astro';
import Related from '../../components/Related.astro';
import PlayShell from '../../components/PlayShell.astro';
import PlayFrame from '../../components/PlayFrame.astro';
import { games, locales, type Locale, type Game } from '../../data/games';
import { ui } from '../../i18n/ui';
import { gameLabels } from '../../lib/game-labels';
import Catalog from '../../components/Catalog.astro';
import Hero from '../../components/Hero.astro';
import StudioFooter from '../../components/StudioFooter.astro';
import { catalogEntry, type CatalogEntry } from '../../lib/catalog';
export async function getStaticPaths() {
  const design = process.env.WGS_DESIGN_PREVIEW === '1' ? (await import('../../design/catalog')).designCatalog : [];

  return locales.flatMap(locale => [
    ...(design.length ? [...['design-preview', 'design-preview/games'].map(path => ({ params: { locale, path }, props: { locale, path, preview: true, entries: design } })), ...design.flatMap(entry => ['games', 'play'].map(prefix => ({ params: { locale, path: `design-preview/${prefix}/${entry.slug}` }, props: { locale, path: `design-preview/${prefix}/${entry.slug}`, preview: true, entry } })))] : []),
    ...['', 'games', 'about', 'privacy', 'terms', 'contact'].map(path => ({ params: { locale, path: path || undefined }, props: { locale, path } })),
    ...games.flatMap(game => ['games', 'play'].map(prefix => ({ params: { locale, path: `${prefix}/${game.slug}` }, props: { locale, path: `${prefix}/${game.slug}`, game } }))),
  ]);
}
interface Props { locale: Locale; path: string; game?: Game; preview?: boolean; entries?: CatalogEntry[]; entry?: CatalogEntry }
const { locale, path, game, preview = false, entries = [], entry } = Astro.props;
const isCatalog = ['', 'games', 'design-preview', 'design-preview/games'].includes(path);
const isIndex = path === 'games' || path === 'design-preview/games';
const t = ui[locale];
const fixture = games[0]!;
const released = games.filter(entry => entry.state === 'released');
const title = entry ? entry.title[locale] : game ? game.title[locale] : isIndex ? t.collection : path === 'about' ? t.about : path === 'privacy' ? t.privacy : path === 'terms' ? t.terms : path === 'contact' ? t.contact : t.home;
---
<Layout locale={locale} path={path} title={title} description={game?.description[locale] ?? entry?.description[locale]} preview={preview} catalog={isCatalog}>
  {isCatalog && <>
    {isIndex ? <section class="index-heading"><a class="text-link" href={`/${locale}/${preview ? 'design-preview/' : ''}`}>← {t.home}</a><h1>{t.collection}</h1><p>{locale === 'ja' ? '気になる作品を、検索やカテゴリから。' : 'Find your next favorite by name or category.'}</p></section> : <Hero locale={locale} preview={preview} />}
    <Catalog locale={locale} entries={preview ? entries : released.map(catalogEntry)} preview={preview} />
    {!isIndex && <StudioFooter locale={locale} preview={preview} />}
    {!preview && <section class="internal-link"><span class="badge">{t.internal}</span><a class="text-link" href={`/${locale}/play/${fixture.slug}/`}>{t.openLab} ↗</a><a class="text-link" href={`/${locale}/games/${fixture.slug}/`}>{t.details}</a></section>}
  </>}
  {entry && <>
    {path.includes('/games/') && <div class="breadcrumb"><a data-catalog-return href={`/${locale}/design-preview/`}>← {t.games}</a><span>/</span>{entry.title[locale]}</div>}
    {path.includes('/games/') ? <section class="detail-hero"><img class="detail-cover" src={entry.cover} width="480" height="288" alt="" /><div class="detail-copy"><span class="badge">{locale === 'ja' ? '仮作品・ゲーム未制作' : 'Sample title · game not built'}</span><h1>{entry.title[locale]}</h1><p>{entry.description[locale]}</p><a class="button primary" data-catalog-state-link href={`/${locale}/design-preview/play/${entry.slug}/`}>{locale === 'ja' ? 'Play画面の見本を見る' : 'View play screen sample'} →</a></div></section> : <>
      <PlayFrame game={entry} locale={locale}><div class="sample-stage"><img src={entry.cover} width="480" height="288" alt="" /><div class="sample-message"><span class="sample-symbol" aria-hidden="true">✧</span><h2>{locale === 'ja' ? 'ここに、遊びの世界を。' : 'A little world will live here.'}</h2><p>{locale === 'ja' ? 'これはPlay周辺のデザイン見本です。このゲームはまだ制作されていません。' : 'This is a visual sample of the play screen. This game has not been built.'}</p><a class="button primary" data-catalog-return href={`/${locale}/design-preview/`}>{locale === 'ja' ? 'ほかの見本を見る' : 'Explore the samples'} →</a></div></div><aside class="sample-aside" slot="aside"><h2>{locale === 'ja' ? 'ひと目でわかる遊び' : 'A little idea to play with'}</h2><p>{entry.description[locale]}</p><p>{locale === 'ja' ? '仮タイトルと仮Artwork。操作方法や保存仕様は、実ゲームの制作時に決まります。' : 'A working title and temporary artwork. Controls and save behavior will be defined with the real game.'}</p><a class="text-link" href={`/${locale}/play/connection-lab/`}>{t.openLab} ↗</a></aside></PlayFrame>
    </>}
  </>}
  {game && path.startsWith('games/') && <>
    <div class="breadcrumb"><a data-catalog-return href={`/${locale}/games/`}>{t.games}</a><span>/</span>{game.title[locale]}</div>
    <section class="detail-hero"><img class="detail-cover" src={game.cover} width="960" height="660" alt="" /><div class="detail-copy"><span class="badge">{game.state === 'internal' ? `${t.internal} · ${t.noCount}` : game.state === 'draft' ? t.concept : game.category[locale]}</span><h1>{game.title[locale]}</h1><p>{game.description[locale]}</p><a class="button primary" data-catalog-state-link href={`/${locale}/play/${game.slug}/`}>{game.state === 'internal' ? t.play : locale === 'ja' ? 'プレイする' : 'Play game'}<span aria-hidden="true">↗</span></a><dl class="game-facts">{(['device', 'inputs', 'save', 'version'] as const).map((key, index) => <div><dt>{t[key]}</dt><dd>{[gameLabels(game, locale).devices, gameLabels(game, locale).inputs, t.saveValue, game.version][index]}</dd></div>)}</dl></div></section>
    <section class="how-to"><span class="eyebrow accent">HOW TO</span><h2>{t.howTo}</h2><p>{t.instructions}</p></section><Related game={game} locale={locale} />
  </>}
  {game && path.startsWith('play/') && <><PlayShell game={game} locale={locale} /><Related game={game} locale={locale} /></>}
  {path === 'about' && <article class="prose-page"><span class="eyebrow accent">THE STUDIO</span><h1>{t.aboutTitle}</h1><p class="lead">{t.aboutBody}</p><p>{t.aboutSecond}</p><div class="about-note"><span class="badge">{t.local}</span><p>{t.previewNote}</p><a class="text-link" href={`/${locale}/games/`}>{t.browse} ↗</a></div></article>}
  {(path === 'privacy' || path === 'terms') && <article class="prose-page"><span class="badge draft">{t.draft}</span><h1>{path === 'privacy' ? t.privacyTitle : t.termsTitle}</h1><p class="draft-note">{t.draftNote}</p><p>{path === 'privacy' ? t.privacyBody : t.termsBody}</p><p>{path === 'privacy' ? t.privacySecond : t.termsSecond}</p><a class="text-link" href={`/${locale}/contact/`}>{t.contact} ↗</a></article>}
  {path === 'contact' && <article class="prose-page"><span class="eyebrow accent">SUPPORT</span><h1>{t.contactTitle}</h1><p class="lead">{t.contactBody}</p><p>{t.contactSecond}</p><a class="button secondary" href={`/${locale}/`}>{t.home} ↗</a></article>}
</Layout>
