---
import './site.css';
import AnalyticsConsent from '../rc/AnalyticsConsent.astro';
import site from '../rc/site.json';
import type {Locale} from '../data/games';
interface Props{locale:Locale;title:string;description?:string;path?:string;image?:string}
const {locale,title,description=locale==='ja'?'小さなゲームと、ちょっと明るい毎日。日本語と英語で遊べる5つのオリジナルゲーム。':'Small games. A brighter everyday. Five original browser games in Japanese and English.',path='',image='/covers/tiny-delivery-a.webp'}=Astro.props;
const t=(ja:string,en:string)=>locale==='ja'?ja:en;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#f7fbff"/><title>{title} | Tinlumo</title><meta property="og:title" content={`${title} | Tinlumo`}/><meta property="og:description" content={description}/><meta property="og:image" content={image}/><link rel="icon" href="/favicon.svg"/></head>
<body><a class="skip-link" href="#main">{t('本文へ','Skip to content')}</a>
<header class="site-head wrap"><a class="brand" href={`/${locale}/`} aria-label={t('Tinlumo ホーム','Tinlumo home')}><img src="/favicon.svg" width="40" height="40" alt=""/><span>tinlumo</span><i aria-hidden="true">✦</i></a><nav class="main-nav" aria-label={t('メインナビゲーション','Main navigation')}><a href={`/${locale}/`} aria-current={path===''?'page':undefined}>{t('ホーム','Home')}</a><a href={`/${locale}/games/`} aria-current={path==='games'?'page':undefined}>{t('ゲーム','Games')}</a><a href={`/${locale}/about/`} aria-current={path==='about'?'page':undefined}>{t('スタジオ','About')}</a></nav><nav class="language" aria-label={t('表示言語','Language')}>{(['ja','en'] as const).map(lang=><a href={`/${lang}/${path?path+'/':''}`} data-locale-link lang={lang} aria-current={locale===lang?'page':undefined}>{lang.toUpperCase()}</a>)}</nav></header>
<main id="main" class="wrap"><slot/></main>
<footer class="site-footer wrap"><div class="footer-statement"><span class="spark" aria-hidden="true">✦</span><h2>Play instantly.<br/>More good days.</h2><p>{t('小さな遊びを、いつものブラウザーで。','Little games, right in your browser.')}<br/>{t('無料・ダウンロード不要・広告なし。','Free. No downloads. No ads.')}</p><span class="footer-fact">5 {t('つの世界','original worlds')}<br/>JA / EN</span></div><div class="footer-bottom"><a class="footer-brand" href={`/${locale}/`}>Tinlumo</a><span>{site.creatorBrand}</span><nav aria-label={t('サイト情報','Site information')}>{[['about',t('スタジオ','About')],['privacy',t('プライバシー','Privacy')],['terms',t('利用規約','Terms')],['contact',t('お問い合わせ','Contact')],['credits',t('クレジット','Credits')],['video-policy',t('動画利用方針','Video policy')],['settings',t('設定','Settings')]].map(([key,label])=><a href={`/${locale}/${key}/`}>{label}</a>)}</nav><button type="button" class="text-button" data-open-analytics>{t('計測の設定','Analytics settings')}</button></div></footer>
<AnalyticsConsent locale={locale}/><script is:inline type="module" src="/assets/public-language.js"></script><script is:inline type="module" src="/assets/visual-portal.js"></script></body></html>

