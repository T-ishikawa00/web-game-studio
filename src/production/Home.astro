---
import {games,definition} from './catalog';
import type {Locale} from '../data/games';
const {locale}=Astro.props as {locale:Locale};const t=(ja:string,en:string)=>locale==='ja'?ja:en;
---
<section class="home-hero"><div class="hero-copy"><p class="eyebrow">TINLUMO — BROWSER GAMES FOR EVERYONE</p><h1>Small Games.<br/>A Brighter<br class="desktop-break"/> Everyday.</h1><p class="hero-description">{t('小さなゲームと、ちょっと明るい毎日。','Play instantly in your browser.')}<br/>{t('ブラウザーから、5つの世界へ。','Five original games, endless little adventures.')}</p><div class="actions"><a class="button primary" href={`/${locale}/play/tiny-delivery/`}><span aria-hidden="true">▶</span>{t('今すぐ遊ぶ','Play now')}</a><a class="button secondary" href="#games">{t('ゲームを見る','Explore games')} <span aria-hidden="true">→</span></a></div><p class="hand-note">Good games.<br/>Brighter days.</p></div><div class="featured">{games.map((game,index)=><article class="feature-panel" id={`feature-${game.id}`} hidden={index!==0}><img class="feature-art" src={`/scenes/${game.id}.webp`} alt={`${game.title[locale]} · ${t('実ゲームの世界','Actual game world')}`} width="1280" height="800" loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'} decoding="async"/><div class="feature-copy"><span class="eyebrow">TINLUMO ORIGINAL</span><h2>{game.title[locale]}</h2><p>{definition(game.id).summary[locale]}</p><a class="button coral" href={`/${locale}/play/${game.slug}/`}><span aria-hidden="true">▶</span>{t('遊んでみる','Play in browser')}</a></div></article>)}<div class="feature-controls" hidden data-feature-controls aria-label={t('注目のゲーム','Featured game')}>{games.map((game,index)=><button type="button" data-feature={game.id} aria-controls={`feature-${game.id}`} aria-pressed={index===0} aria-label={game.title[locale]}><span>{index+1}</span></button>)}</div></div></section>
