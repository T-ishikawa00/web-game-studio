---
import type {Game,Locale} from '../data/games';
import {facts,genre,saveNote,definition} from './catalog';
import {coverAlt,playGuide} from './copy';
const {game,locale}=Astro.props as {game:Game;locale:Locale};const t=(ja:string,en:string)=>locale==='ja'?ja:en,info=facts(game);
---
<nav class="breadcrumb" aria-label={t('現在地','Breadcrumb')}><a href={`/${locale}/games/`}>← {t('すべてのゲーム','All games')}</a><span aria-hidden="true">/</span><span>{game.title[locale]}</span></nav>
<section class="detail-hero" data-game={game.id}><div class="detail-art"><img src={game.cover} width="1280" height="800" alt={`${game.title[locale]} · ${coverAlt[game.id]![locale]}`} fetchpriority="high"/></div><div class="detail-copy"><p class="eyebrow">{genre[game.id]![locale]}</p><h1>{game.title[locale]}</h1>{game.pronunciation&&locale==='ja'&&<p class="pronunciation">{game.pronunciation.ja}</p>}<p class="detail-summary">{definition(game.id).summary[locale]}</p><p>{game.description[locale]}</p><a class="button primary" href={`/${locale}/play/${game.slug}/`}><span aria-hidden="true">▶</span>{t('今すぐ遊ぶ','Play now')}</a><dl class="game-facts"><div><dt>{t('内容','Game content')}</dt><dd>{info.count[locale]}</dd></div><div><dt>{t('操作','Controls')}</dt><dd>{info.controls[locale]}</dd></div><div><dt>{t('言語','Languages')}</dt><dd>日本語 / English</dd></div></dl></div></section>
<section class="detail-story"><div><p class="eyebrow">A LITTLE WORLD TO EXPLORE</p><h2>{t('ここでは、こんな遊びを。','A little look inside.')}</h2><p>{playGuide[game.id]![locale]}</p><p>{t('ゲーム内の設定から、音や動きの量を調整できます。','Adjust sound and motion in the game settings.')}</p></div><img src={`/scenes/${game.id}.webp`} alt={`${game.title[locale]} · ${t('実際のゲーム画面','Actual game screen')}`} width="1280" height="800" loading="lazy" decoding="async"/></section>
<details class="save-details"><summary>{t('保存・ブラウザー・クレジット','Saves, browsers & credits')}</summary><p>{saveNote(game.id,locale)}</p><p>{t('同じ端末・ブラウザー・サイトで保存を共有します。別端末への同期はありません。サイトデータを削除すると保存も失われます。','Saves belong to this device, browser and site. There is no cross-device sync. Clearing site data removes saved progress.')}</p><p>{t('WebGL 2に対応し、3D描画を利用できるブラウザーが必要です。','A browser with WebGL 2 and 3D graphics enabled is required.')}</p><a href={`/${locale}/credits/`}>{t('制作情報・ライセンス','Credits & licenses')} →</a></details>
