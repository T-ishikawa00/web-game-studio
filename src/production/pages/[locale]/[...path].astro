---
import Layout from '../../Layout.astro';
import Home from '../../Home.astro';
import Cards from '../../Cards.astro';
import Detail from '../../Detail.astro';
import GamePage from '../../GamePage.astro';
import Credits from '../../Credits.astro';
import PublicOperations from '../../../rc/PublicOperations.astro';
import {games} from '../../catalog';
import {locales,type Locale,type Game} from '../../../data/games';
export function getStaticPaths(){return locales.flatMap(locale=>[
 ...['','games','about','privacy','terms','contact','credits','video-policy','settings'].map(path=>({params:{locale,path:path||undefined},props:{locale,path}})),
 ...games.flatMap(game=>['games','play'].map(prefix=>({params:{locale,path:`${prefix}/${game.slug}`},props:{locale,path:`${prefix}/${game.slug}`,game}})))
]);}
const {locale,path,game}=Astro.props as {locale:Locale;path:string;game?:Game};const t=(ja:string,en:string)=>locale==='ja'?ja:en;
const labels:Record<string,string>={games:t('ゲーム一覧','Our games'),about:t('スタジオについて','About Tinlumo'),privacy:t('プライバシー','Privacy'),terms:t('利用規約','Terms'),contact:t('お問い合わせ','Contact'),credits:t('クレジット','Credits'),'video-policy':t('実況・動画利用方針','Gameplay & video policy'),settings:t('設定','Settings')};
---
{path.startsWith('play/')&&game?<GamePage game={game} locale={locale}/>:<Layout locale={locale} path={path} title={game?.title[locale]??labels[path]??'Small Games. A Brighter Everyday.'} description={game?.description[locale]} image={game?.cover}>
 {path===''&&<Home locale={locale}/>}
 {path==='games'&&<div class="page-intro"><p class="eyebrow">FIVE ORIGINAL WORLDS</p><h1>{t('気になる世界へ。','Find your little adventure.')}</h1><p>{t('ダウンロードも、登録もいりません。','No downloads. No sign-up. Just play.')}</p></div>}
 {game&&<Detail game={game} locale={locale}/>}
 {(game||path===''||path==='games')&&<Cards games={game?games.filter(g=>g.id!==game.id):games} locale={locale} related={!!game}/>}
 {path==='credits'?<Credits locale={locale}/>:path==='settings'?<article class="prose"><p class="eyebrow">MAKE YOURSELF COMFORTABLE</p><h1>{labels.settings}</h1><h2>{t('アクセス計測','Analytics')}</h2><p>{t('計測は初期状態でオフです。許可しなくても、すべてのゲームを遊べます。選択はいつでも変更できます。','Analytics is off by default. Every game is available without permission. You can change your choice at any time.')}</p><button class="button secondary" type="button" data-open-analytics>{t('計測の選択を変更','Change analytics choice')}</button><h2>{t('ゲームの設定と保存','Game settings & saves')}</h2><p>{t('音・動き・進行の設定は、各ゲーム内で変更できます。作品ごとに保存し、他のゲームの進行には影響しません。','Adjust sound, motion and progress inside each game. Games keep their own saves, without changing progress in other games.')}</p><a href={`/${locale}/privacy/`}>{t('データの取扱いを見る','Read about your data')} →</a></article>:labels[path]&&path!=='games'&&<PublicOperations locale={locale} page={path}/>}
 {path==='settings'&&<section class="prose" id="hakorilo-save"><h2>{t('Hakoriloの進行を消去','Erase Hakorilo progress')}</h2><p>{t('Hakoriloの進行・クリア記録・動きを控える設定だけを消去します。音の設定と、ほかの作品の保存は残ります。','Erase only Hakorilo progress, completions and its reduced-motion setting. Sound preferences and other games remain unchanged.')}</p><button class="button secondary" type="button" data-reset-hakorilo>{t('消去の確認へ','Review deletion')}</button><p id="reset-result" role="status"></p><dialog id="hakorilo-reset"><h2>{t('Hakoriloの進行を消去しますか？','Erase Hakorilo progress?')}</h2><p>{t('この操作は取り消せません。ほかの作品には影響しません。','This cannot be undone. Other games are unaffected.')}</p><div class="actions"><form method="dialog"><button class="button secondary">{t('やめる','Cancel')}</button></form><button class="button coral" type="button" data-confirm-reset>{t('進行を消去','Erase progress')}</button></div></dialog></section>}
</Layout>}
{path==='settings'&&<script is:inline type="module" src="/assets/save-settings.js"></script>}
