---
import type { Game, Locale } from '../data/games';
import { catalogEntry, categoryLabels, searchText, type CatalogEntry } from '../lib/catalog';
import { ui } from '../i18n/ui';
interface Props { game: Game | CatalogEntry; locale: Locale; related?: boolean; index?: number }
const { game, locale, related = false, index = 9 } = Astro.props;
const entry = 'categories' in game ? game : catalogEntry(game);
const prefix = entry.state === 'design' ? 'design-preview/play' : 'play';
---
<a class="game-card" href={`/${locale}/${prefix}/${entry.slug}/`} data-event={entry.state === 'design' ? undefined : related ? 'related_game_open' : 'game_card_open'} data-game={entry.id} data-search={searchText(entry)} data-categories={entry.categories.join(' ')} data-index={index}>
  <div class="game-cover"><span class="art-fallback" aria-hidden="true">✧</span><img src={entry.cover} width="480" height="288" alt="" loading={index < 5 ? 'eager' : 'lazy'} decoding="async" />{entry.state === 'internal' && <span class="cover-tag">{ui[locale].internal}</span>}</div>
  <div class="card-body"><h3>{entry.title[locale]}</h3><p>{entry.description[locale]}</p><div class="card-bottom"><span class="card-tags">{entry.categories.slice(0, 2).map(c => <span class={`tag tag-${c}`}>{categoryLabels[locale][c]}</span>)}{entry.state === 'internal' && <span class="tag">{ui[locale].internal}</span>}</span><span class="card-play" aria-hidden="true">▶</span></div></div>
</a>
